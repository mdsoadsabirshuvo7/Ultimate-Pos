(function () {
  if (!('serviceWorker' in navigator)) {
    return;
  }

  var statusBanner = null;
  var syncWidget = null;
  var BASE_CRITICAL_ROUTES = [
    '/home',
    '/superadmin',
    '/users',
    '/roles',
    '/products',
    '/products/create',
    '/contacts?type=customer',
    '/contacts?type=supplier',
    '/purchases',
    '/purchases/create',
    '/sells',
    '/sells/create',
    '/pos',
    '/pos/create',
    '/stock-adjustments',
    '/stock-transfers',
    '/expenses',
    '/accounting/dashboard',
    '/reports/profit-loss'
  ];
  var MAX_DYNAMIC_ROUTES = 160;
  var DB_NAME = 's71-offline-db';
  var STORE_NAME = 'request-queue';
  var MAX_LOG_ENTRIES = 6;
  var WIDGET_MODE_KEY = 's71-sync-widget-mode';
  var AUTO_HIDE_DELAY_MS = 9000;

  var syncState = {
    pending: 0,
    isSyncing: false,
    lastSyncAt: 0,
    nextRetryAt: 0,
    lastError: '',
    lastErrorUrl: '',
    lastErrorMethod: '',
    lastErrorRetry: 0,
    droppedTotal: 0,
    lastDroppedUrl: '',
    lastDroppedMethod: '',
    lastDroppedAt: 0,
    autoHide: false,
    collapsed: false
  };
  var syncLog = [];
  var autoHideTimer = null;
  var nextRetryTimer = null;
  var swMessageBound = false;

  function ensureBanner() {
    if (statusBanner) {
      return statusBanner;
    }

    statusBanner = document.createElement('div');
    statusBanner.id = 's71-offline-banner';
    statusBanner.style.position = 'fixed';
    statusBanner.style.left = '50%';
    statusBanner.style.top = '10px';
    statusBanner.style.transform = 'translateX(-50%)';
    statusBanner.style.padding = '10px 14px';
    statusBanner.style.background = '#b91c1c';
    statusBanner.style.color = '#fff';
    statusBanner.style.zIndex = '99999';
    statusBanner.style.fontSize = '13px';
    statusBanner.style.borderRadius = '8px';
    statusBanner.style.boxShadow = '0 8px 24px rgba(0,0,0,.2)';
    statusBanner.style.display = 'none';
    statusBanner.textContent = 'You are offline. Changes will be queued and synced automatically.';

    document.body.appendChild(statusBanner);
    return statusBanner;
  }

  function ensureSyncWidget() {
    if (syncWidget) {
      return syncWidget;
    }

    syncWidget = document.createElement('div');
    syncWidget.id = 's71-sync-widget';
    syncWidget.style.position = 'fixed';
    syncWidget.style.right = '14px';
    syncWidget.style.bottom = '14px';
    syncWidget.style.zIndex = '99998';
    syncWidget.style.minWidth = '180px';
    syncWidget.style.padding = '10px 12px';
    syncWidget.style.borderRadius = '10px';
    syncWidget.style.fontSize = '12px';
    syncWidget.style.lineHeight = '1.35';
    syncWidget.style.boxShadow = '0 8px 22px rgba(0,0,0,.16)';
    syncWidget.style.color = '#fff';
    syncWidget.style.userSelect = 'none';
    syncWidget.style.display = 'block';
    syncWidget.setAttribute('aria-live', 'polite');

    syncWidget.addEventListener('mouseenter', function () {
      if (syncState.autoHide) {
        expandWidget();
        clearAutoHideTimer();
      }
    });

    syncWidget.addEventListener('mouseleave', function () {
      if (syncState.autoHide) {
        scheduleAutoHide();
      }
    });

    document.body.appendChild(syncWidget);
    return syncWidget;
  }

  function formatTime(ts) {
    if (!ts) {
      return '--';
    }

    try {
      return new Date(ts).toLocaleTimeString();
    } catch (_) {
      return '--';
    }
  }

  function escapeHtml(text) {
    return String(text || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function toDisplayUrl(rawUrl) {
    if (!rawUrl) {
      return '';
    }

    try {
      var parsed = new URL(String(rawUrl), window.location.origin);
      return parsed.pathname + (parsed.search || '');
    } catch (_) {
      return String(rawUrl);
    }
  }

  function addSyncLog(message) {
    syncLog.unshift({
      at: Date.now(),
      message: String(message || '')
    });

    if (syncLog.length > MAX_LOG_ENTRIES) {
      syncLog = syncLog.slice(0, MAX_LOG_ENTRIES);
    }
  }

  function buildDiagnosticsText() {
    var lines = [];
    lines.push('S71 Sync Diagnostics');
    lines.push('Generated: ' + new Date().toISOString());
    lines.push('Page: ' + window.location.href);
    lines.push('Online: ' + (navigator.onLine ? 'yes' : 'no'));
    lines.push('Pending queue: ' + String(syncState.pending));
    lines.push('Is syncing: ' + (syncState.isSyncing ? 'yes' : 'no'));
    lines.push('Last sync: ' + formatTime(syncState.lastSyncAt));
    lines.push('Next retry: ' + formatTime(syncState.nextRetryAt));
    lines.push('Last error: ' + (syncState.lastError || '--'));
    lines.push('Last error endpoint: ' + ((syncState.lastErrorMethod ? syncState.lastErrorMethod + ' ' : '') + (syncState.lastErrorUrl || '--')));
    lines.push('Last error retry: ' + String(syncState.lastErrorRetry || 0));
    lines.push('Dropped items: ' + String(syncState.droppedTotal || 0));
    lines.push('Last dropped endpoint: ' + ((syncState.lastDroppedMethod ? syncState.lastDroppedMethod + ' ' : '') + (syncState.lastDroppedUrl || '--')));
    lines.push('Last dropped at: ' + formatTime(syncState.lastDroppedAt));
    lines.push('');
    lines.push('Recent events:');

    if (!syncLog.length) {
      lines.push('- none');
    } else {
      syncLog.forEach(function (entry) {
        lines.push('- ' + new Date(entry.at).toISOString() + ' ' + String(entry.message || ''));
      });
    }

    return lines.join('\n');
  }

  function copyTextFallback(text) {
    try {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', 'readonly');
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      var ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return !!ok;
    } catch (_) {
      return false;
    }
  }

  function copyDiagnostics() {
    var text = buildDiagnosticsText();

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text)
        .then(function () {
          addSyncLog('Diagnostics copied to clipboard.');
          notify('Diagnostics copied.', 'success');
          renderSyncWidget();
        })
        .catch(function () {
          if (copyTextFallback(text)) {
            addSyncLog('Diagnostics copied to clipboard.');
            notify('Diagnostics copied.', 'success');
          } else {
            addSyncLog('Diagnostics copy failed.');
            notify('Could not copy diagnostics.', 'error');
          }
          renderSyncWidget();
        });
      return;
    }

    if (copyTextFallback(text)) {
      addSyncLog('Diagnostics copied to clipboard.');
      notify('Diagnostics copied.', 'success');
    } else {
      addSyncLog('Diagnostics copy failed.');
      notify('Could not copy diagnostics.', 'error');
    }
    renderSyncWidget();
  }

  function exportDiagnostics() {
    var text = buildDiagnosticsText();
    var ts = new Date();
    var filename = 's71-sync-diagnostics-' +
      String(ts.getFullYear()) +
      String(ts.getMonth() + 1).padStart(2, '0') +
      String(ts.getDate()).padStart(2, '0') + '-' +
      String(ts.getHours()).padStart(2, '0') +
      String(ts.getMinutes()).padStart(2, '0') +
      String(ts.getSeconds()).padStart(2, '0') + '.txt';

    var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () {
      URL.revokeObjectURL(url);
    }, 1000);

    addSyncLog('Diagnostics exported.');
    notify('Diagnostics file downloaded.', 'success');
    renderSyncWidget();
  }

  function getWidgetMode() {
    try {
      return localStorage.getItem(WIDGET_MODE_KEY) === 'auto' ? 'auto' : 'fixed';
    } catch (_) {
      return 'fixed';
    }
  }

  function setWidgetMode(mode) {
    try {
      localStorage.setItem(WIDGET_MODE_KEY, mode === 'auto' ? 'auto' : 'fixed');
    } catch (_) {
      // Ignore localStorage write errors.
    }
  }

  function clearAutoHideTimer() {
    if (autoHideTimer) {
      clearTimeout(autoHideTimer);
      autoHideTimer = null;
    }
  }

  function clearNextRetryTimer() {
    if (nextRetryTimer) {
      clearTimeout(nextRetryTimer);
      nextRetryTimer = null;
    }
  }

  function scheduleNextRetrySync(ts) {
    clearNextRetryTimer();
    if (!ts || !navigator.onLine) {
      return;
    }

    var delay = Math.max(0, Number(ts) - Date.now() + 1200);
    nextRetryTimer = setTimeout(function () {
      requestSyncNow(false);
    }, delay);
  }

  function shouldAutoHideWidget() {
    return syncState.autoHide && navigator.onLine && !syncState.isSyncing && syncState.pending === 0 && !syncState.lastError && syncState.droppedTotal === 0;
  }

  function scheduleAutoHide() {
    clearAutoHideTimer();
    if (!shouldAutoHideWidget() || syncState.collapsed) {
      return;
    }

    autoHideTimer = setTimeout(function () {
      syncState.collapsed = true;
      renderSyncWidget();
    }, AUTO_HIDE_DELAY_MS);
  }

  function expandWidget() {
    if (!syncState.collapsed) {
      return;
    }
    syncState.collapsed = false;
    renderSyncWidget();
  }

  function renderSyncWidget() {
    var widget = ensureSyncWidget();
    var bg = '#065f46';
    var status = 'Synced';
    var logsHtml = '';
    var modeLabel = syncState.autoHide ? 'Auto hide: on' : 'Auto hide: off';
    var errorLine = '';
    var errorMetaLine = '';
    var droppedLine = '';
    var nextRetryLine = '';

    if (!navigator.onLine) {
      bg = '#b91c1c';
      status = 'Offline';
    } else if (syncState.isSyncing) {
      bg = '#1d4ed8';
      status = 'Syncing';
    } else if (syncState.pending > 0) {
      bg = '#b45309';
      status = 'Queued';
    }

    logsHtml = syncLog.map(function (entry) {
      return '<div style="opacity:.96; margin-top:2px;">' +
        '<span style="opacity:.85;">' + escapeHtml(formatTime(entry.at)) + '</span> ' +
        '<span>' + escapeHtml(entry.message) + '</span>' +
      '</div>';
    }).join('');

    if (syncState.lastError) {
      errorLine = '<div style="margin-top:6px; color:#fde68a;">Last error: ' + escapeHtml(syncState.lastError) + '</div>';
      if (syncState.lastErrorUrl || syncState.lastErrorRetry > 0 || syncState.lastErrorMethod) {
        errorMetaLine = '<div style="margin-top:2px; color:#fde68a; opacity:.95;">' +
          escapeHtml((syncState.lastErrorMethod ? syncState.lastErrorMethod + ' ' : '') + (syncState.lastErrorUrl || '') + (syncState.lastErrorRetry > 0 ? ' (retry ' + syncState.lastErrorRetry + ')' : '')) +
        '</div>';
      }
    }

    if (syncState.droppedTotal > 0) {
      droppedLine = '<div style="margin-top:6px; color:#fecaca;">Dropped items: ' + escapeHtml(String(syncState.droppedTotal)) + ' (retry limit reached)</div>';
      if (syncState.lastDroppedUrl || syncState.lastDroppedMethod) {
        droppedLine += '<div style="margin-top:2px; color:#fecaca; opacity:.95;">' +
          escapeHtml((syncState.lastDroppedMethod ? syncState.lastDroppedMethod + ' ' : '') + (syncState.lastDroppedUrl || '') + (syncState.lastDroppedAt ? ' @ ' + formatTime(syncState.lastDroppedAt) : '')) +
        '</div>';
      }
    }

    if (syncState.nextRetryAt && syncState.nextRetryAt > Date.now() && syncState.pending > 0) {
      nextRetryLine = '<div style="margin-top:6px; color:#bfdbfe;">Next retry: ' + escapeHtml(formatTime(syncState.nextRetryAt)) + '</div>';
    }

    widget.style.background = bg;
    if (syncState.collapsed && shouldAutoHideWidget()) {
      widget.innerHTML =
        '<div style="display:flex; align-items:center; gap:8px;">' +
          '<div style="font-weight:700;">' + status + '</div>' +
          '<div style="opacity:.9;">Q:' + String(syncState.pending) + '</div>' +
          '<button data-sync-action="expand-widget" style="margin-left:auto; padding:3px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">Show</button>' +
        '</div>';
      return;
    }

    widget.innerHTML =
      '<div style="font-weight:700; margin-bottom:4px;">' + status + '</div>' +
      '<div>Queued: ' + String(syncState.pending) + '</div>' +
      '<div>Last sync: ' + formatTime(syncState.lastSyncAt) + '</div>' +
      nextRetryLine +
      errorLine +
      errorMetaLine +
      droppedLine +
      '<div style="display:flex; gap:6px; margin-top:8px;">' +
        '<button data-sync-action="sync-now" style="flex:1; padding:4px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">Sync now</button>' +
        '<button data-sync-action="clear-queue" style="flex:1; padding:4px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">Clear queue</button>' +
      '</div>' +
      '<div style="display:flex; gap:6px; margin-top:6px;">' +
        '<button data-sync-action="toggle-autohide" style="flex:1; padding:4px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">' + modeLabel + '</button>' +
      '</div>' +
      '<div style="display:flex; gap:6px; margin-top:6px;">' +
        '<button data-sync-action="copy-diagnostics" style="flex:1; padding:4px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">Copy log</button>' +
        '<button data-sync-action="export-diagnostics" style="flex:1; padding:4px 6px; border:0; border-radius:6px; cursor:pointer; font-size:11px;">Export log</button>' +
      '</div>' +
      '<div style="margin-top:8px; font-size:11px; max-height:68px; overflow:auto; border-top:1px solid rgba(255,255,255,.25); padding-top:6px;">' + logsHtml + '</div>';

    if (shouldAutoHideWidget()) {
      scheduleAutoHide();
    } else {
      clearAutoHideTimer();
      syncState.collapsed = false;
    }
  }

  function setBannerVisibility(isOffline) {
    var banner = ensureBanner();
    banner.style.display = isOffline ? 'block' : 'none';
  }

  function notify(message, type) {
    if (window.toastr) {
      if (type === 'error') {
        toastr.error(message);
      } else if (type === 'warning') {
        toastr.warning(message);
      } else {
        toastr.success(message);
      }
      return;
    }

    if (window.console && console.log) {
      console.log('[offline-sync] ' + message);
    }
  }

  function postToSW(message) {
    if (navigator.serviceWorker.controller) {
      navigator.serviceWorker.controller.postMessage(message);
      return;
    }

    navigator.serviceWorker.ready
      .then(function (registration) {
        if (registration && registration.active) {
          registration.active.postMessage(message);
        }
      })
      .catch(function () {
        // Ignore transient readiness errors.
      });
  }

  function requestSyncNow(isManual) {
    syncState.isSyncing = true;
    syncState.nextRetryAt = 0;
    clearNextRetryTimer();
    syncState.lastError = '';
    clearAutoHideTimer();
    syncState.collapsed = false;
    if (isManual) {
      addSyncLog('Manual sync requested.');
    }
    renderSyncWidget();
    postToSW({ type: 'SYNC_NOW' });
    setTimeout(function () {
      refreshQueueState(false);
    }, 2500);
  }

  function clearLocalQueueStore() {
    return openQueueDb()
      .then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction(STORE_NAME, 'readwrite');
          tx.objectStore(STORE_NAME).clear();
          tx.oncomplete = function () {
            db.close();
            resolve();
          };
          tx.onerror = function () {
            db.close();
            reject(tx.error);
          };
        });
      })
      .catch(function () {
        return null;
      });
  }

  function clearQueueNow() {
    postToSW({ type: 'CLEAR_QUEUE_ONLY' });
    clearLocalQueueStore().finally(function () {
      syncState.pending = 0;
      syncState.isSyncing = false;
      syncState.lastError = '';
      syncState.nextRetryAt = 0;
      clearNextRetryTimer();
      syncState.lastErrorUrl = '';
      syncState.lastErrorMethod = '';
      syncState.lastErrorRetry = 0;
      addSyncLog('Queue cleared manually.');
      renderSyncWidget();
      setTimeout(function () {
        refreshQueueState(false);
      }, 600);
    });
  }

  function openQueueDb() {
    return new Promise(function (resolve, reject) {
      var req = indexedDB.open(DB_NAME, 1);

      req.onupgradeneeded = function () {
        var db = req.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
        }
      };

      req.onsuccess = function () {
        resolve(req.result);
      };

      req.onerror = function () {
        reject(req.error);
      };
    });
  }

  function getQueueCount() {
    return openQueueDb()
      .then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction(STORE_NAME, 'readonly');
          var req = tx.objectStore(STORE_NAME).count();

          req.onsuccess = function () {
            resolve(req.result || 0);
            db.close();
          };

          req.onerror = function () {
            reject(req.error);
            db.close();
          };
        });
      })
      .catch(function () {
        return 0;
      });
  }

  function refreshQueueState(markSyncing) {
    if (markSyncing) {
      syncState.isSyncing = true;
      renderSyncWidget();
    }

    return getQueueCount().then(function (count) {
      var previous = syncState.pending;
      syncState.pending = count;

      if (syncState.isSyncing && count === 0 && navigator.onLine) {
        syncState.isSyncing = false;
        syncState.lastSyncAt = Date.now();
        syncState.nextRetryAt = 0;
        clearNextRetryTimer();
        syncState.lastError = '';
        syncState.lastErrorUrl = '';
        syncState.lastErrorMethod = '';
        syncState.lastErrorRetry = 0;
        if (previous > 0 || markSyncing) {
          addSyncLog('Sync completed.');
        }
      }

      if (syncState.isSyncing && count > 0 && navigator.onLine) {
        syncState.isSyncing = false;
      }

      if (previous > 0 && count === 0 && navigator.onLine) {
        syncState.lastSyncAt = Date.now();
        syncState.isSyncing = false;
        syncState.nextRetryAt = 0;
        clearNextRetryTimer();
        syncState.lastError = '';
        syncState.lastErrorUrl = '';
        syncState.lastErrorMethod = '';
        syncState.lastErrorRetry = 0;
        addSyncLog('Queue drained successfully.');
      }

      if (!navigator.onLine) {
        syncState.isSyncing = false;
      }

      if (navigator.onLine && count > 0 && syncState.nextRetryAt && Date.now() >= syncState.nextRetryAt && !syncState.isSyncing) {
        addSyncLog('Retry window reached. Syncing queue.');
        requestSyncNow(false);
      }

      renderSyncWidget();
      return count;
    });
  }

  function normalizeRoute(href) {
    if (!href) {
      return null;
    }

    var trimmed = String(href).trim();
    if (!trimmed || trimmed.charAt(0) === '#' || trimmed.indexOf('javascript:') === 0 || trimmed.indexOf('mailto:') === 0 || trimmed.indexOf('tel:') === 0) {
      return null;
    }

    try {
      var url = new URL(trimmed, window.location.origin);
      if (url.origin !== window.location.origin) {
        return null;
      }

      var pathname = url.pathname || '/';
      if (pathname === '/logout') {
        return null;
      }

      if (/\.(css|js|png|jpe?g|gif|svg|webp|woff2?|eot|ico|map)$/i.test(pathname)) {
        return null;
      }

      return pathname + (url.search || '');
    } catch (_) {
      return null;
    }
  }

  function uniqueRoutes(list) {
    var map = Object.create(null);
    var out = [];

    list.forEach(function (route) {
      if (!route || map[route]) {
        return;
      }
      map[route] = true;
      out.push(route);
    });

    return out;
  }

  function collectSidebarRoutes() {
    var anchors = document.querySelectorAll('#side-bar a[href], .side-bar a[href]');
    var routes = [];

    Array.prototype.forEach.call(anchors, function (anchor) {
      var route = normalizeRoute(anchor.getAttribute('href'));
      if (route) {
        routes.push(route);
      }
    });

    return uniqueRoutes(routes).slice(0, MAX_DYNAMIC_ROUTES);
  }

  function buildWarmRoutes() {
    var routes = [];

    routes = routes.concat(BASE_CRITICAL_ROUTES);
    routes.push(window.location.pathname + window.location.search);
    routes = routes.concat(collectSidebarRoutes());

    return uniqueRoutes(routes);
  }

  function warmCriticalRoutes() {
    postToSW({ type: 'WARM_CRITICAL_ROUTES', routes: buildWarmRoutes() });
  }

  function registerServiceWorker() {
    navigator.serviceWorker.register('/sw.js')
      .then(function () {
        return navigator.serviceWorker.ready;
      })
      .then(function () {
        requestSyncNow();
        if (navigator.onLine) {
          warmCriticalRoutes();
        }
        addSyncLog('Sync monitor ready.');
        refreshQueueState(false);
      })
      .catch(function (error) {
        if (window.console && console.warn) {
          console.warn('Service Worker registration failed:', error);
        }
        addSyncLog('Service worker registration failed.');
      });
  }

  function serializeForm(form) {
    var fd = new FormData(form);
    var params = new URLSearchParams();
    var hasFile = false;

    fd.forEach(function (value, key) {
      if (value instanceof File) {
        if (value.name) {
          hasFile = true;
        }
        return;
      }
      params.append(key, String(value));
    });

    return { body: params.toString(), hasFile: hasFile };
  }

  function bindOfflineFormQueue() {
    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!(form instanceof HTMLFormElement)) {
        return;
      }

      var method = (form.getAttribute('method') || 'GET').toUpperCase();
      if (method === 'GET' || navigator.onLine) {
        return;
      }

      var enctype = (form.getAttribute('enctype') || '').toLowerCase();
      if (enctype.indexOf('multipart/form-data') !== -1) {
        notify('Offline queue does not support file uploads. Please reconnect to submit.', 'error');
        return;
      }

      if (!navigator.serviceWorker.controller) {
        notify('Offline support is initializing. Refresh once while online to enable background sync.', 'warning');
        return;
      }

      var serialized = serializeForm(form);
      if (serialized.hasFile) {
        notify('Offline queue does not support file uploads. Please reconnect to submit.', 'error');
        return;
      }

      event.preventDefault();

      var headers = {
        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
        'X-Requested-With': 'XMLHttpRequest'
      };

      var csrf = document.querySelector('meta[name="csrf-token"]');
      if (csrf && csrf.content) {
        headers['X-CSRF-TOKEN'] = csrf.content;
      }

      fetch(form.action || window.location.href, {
        method: method,
        credentials: 'include',
        headers: headers,
        body: serialized.body
      })
        .then(function (response) {
          if (response.status === 202) {
            notify('Saved offline. It will sync automatically when internet returns.', 'success');
            addSyncLog('Action queued offline.');
            setTimeout(function () {
              refreshQueueState(false);
            }, 500);
          } else {
            notify('Request saved for sync.', 'success');
            addSyncLog('Action accepted and queued.');
            setTimeout(function () {
              refreshQueueState(false);
            }, 500);
          }
        })
        .catch(function () {
          notify('Saved offline. It will sync automatically when internet returns.', 'success');
          addSyncLog('Action queued due to network error.');
          setTimeout(function () {
            refreshQueueState(false);
          }, 500);
        });
    }, true);
  }

  function bindWidgetControls() {
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      var actionEl = target.closest ? target.closest('[data-sync-action]') : null;
      if (!actionEl) {
        return;
      }

      var action = actionEl.getAttribute('data-sync-action') || '';
      if (!action) {
        return;
      }

      event.preventDefault();
      if (action === 'sync-now') {
        requestSyncNow(true);
        return;
      }

      if (action === 'clear-queue') {
        clearQueueNow();
        return;
      }

      if (action === 'toggle-autohide') {
        syncState.autoHide = !syncState.autoHide;
        syncState.collapsed = false;
        setWidgetMode(syncState.autoHide ? 'auto' : 'fixed');
        addSyncLog(syncState.autoHide ? 'Auto-hide enabled.' : 'Auto-hide disabled.');
        renderSyncWidget();
        return;
      }

      if (action === 'copy-diagnostics') {
        copyDiagnostics();
        return;
      }

      if (action === 'export-diagnostics') {
        exportDiagnostics();
        return;
      }

      if (action === 'expand-widget') {
        expandWidget();
      }
    });
  }

  function bindServiceWorkerMessages() {
    if (swMessageBound || !navigator.serviceWorker) {
      return;
    }

    swMessageBound = true;
    navigator.serviceWorker.addEventListener('message', function (event) {
      if (!event || !event.data || !event.data.type) {
        return;
      }

      if (event.data.type === 'SYNC_ERROR') {
        var reason = String(event.data.reason || 'Unknown sync error');
        var retry = Number(event.data.retries || 0);
        var method = String(event.data.method || '').toUpperCase();
        var url = toDisplayUrl(event.data.url || '');
        var dropped = !!event.data.dropped;
        var nextRetryAt = Number(event.data.nextRetryAt || 0);

        syncState.lastError = reason;
        syncState.nextRetryAt = nextRetryAt > Date.now() ? nextRetryAt : 0;
        if (syncState.nextRetryAt) {
          scheduleNextRetrySync(syncState.nextRetryAt);
        }
        syncState.lastErrorRetry = retry > 0 ? retry : 0;
        syncState.lastErrorMethod = method;
        syncState.lastErrorUrl = url;
        syncState.isSyncing = false;
        if (dropped) {
          syncState.droppedTotal = (syncState.droppedTotal || 0) + 1;
          syncState.lastDroppedMethod = method;
          syncState.lastDroppedUrl = url;
          syncState.lastDroppedAt = Date.now();
        }
        addSyncLog('Sync failed' + (url ? ' on ' + url : '') + (retry > 0 ? ' (retry ' + retry + ')' : '') + ': ' + reason + (dropped ? ' [dropped]' : '') + (syncState.nextRetryAt ? ' [next ' + formatTime(syncState.nextRetryAt) + ']' : ''));
        renderSyncWidget();
        return;
      }

      if (event.data.type === 'SYNC_SUCCESS') {
        var okUrl = toDisplayUrl(event.data.url || '');
        var okMethod = String(event.data.method || '').toUpperCase();
        syncState.lastError = '';
        syncState.nextRetryAt = 0;
        clearNextRetryTimer();
        syncState.lastErrorUrl = '';
        syncState.lastErrorMethod = '';
        syncState.lastErrorRetry = 0;
        syncState.isSyncing = false;
        syncState.lastSyncAt = Date.now();
        addSyncLog(okUrl ? ('Synced ' + (okMethod ? okMethod + ' ' : '') + okUrl) : 'Background sync succeeded.');
        refreshQueueState(false);
        return;
      }

      if (event.data.type === 'QUEUE_CLEARED') {
        syncState.pending = 0;
        syncState.lastError = '';
        syncState.nextRetryAt = 0;
        clearNextRetryTimer();
        syncState.lastErrorUrl = '';
        syncState.lastErrorMethod = '';
        syncState.lastErrorRetry = 0;
        addSyncLog('Queue cleared.');
        renderSyncWidget();
      }
    });
  }

  function bindLogoutCacheClear() {
    document.addEventListener('click', function (event) {
      var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
      if (!anchor) {
        return;
      }
      var href = anchor.getAttribute('href') || '';
      if (href.indexOf('/logout') === -1) {
        return;
      }
      postToSW({ type: 'CLEAR_OFFLINE_DATA' });
    });
  }

  function bindRouteWarmOnClick() {
    document.addEventListener('click', function (event) {
      var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
      if (!anchor) {
        return;
      }
      var route = normalizeRoute(anchor.getAttribute('href'));
      if (!route) {
        return;
      }
      postToSW({ type: 'WARM_CRITICAL_ROUTES', routes: [route] });
    });
  }

  function cleanupQueuedFlagFromUrl() {
    var u = new URL(window.location.href);
    if (u.searchParams.get('offline_sync') === 'queued') {
      notify('Action saved offline. It will sync automatically when internet returns.', 'success');
      u.searchParams.delete('offline_sync');
      window.history.replaceState({}, document.title, u.toString());
    }
  }

  function startQueuePolling() {
    refreshQueueState(false);
    setInterval(function () {
      refreshQueueState(false);
    }, 15000);
  }

  document.addEventListener('DOMContentLoaded', function () {
    syncState.autoHide = getWidgetMode() === 'auto';
    ensureSyncWidget();
    addSyncLog('Widget initialized.');
    renderSyncWidget();
    bindServiceWorkerMessages();
    registerServiceWorker();
    bindOfflineFormQueue();
    bindLogoutCacheClear();
    bindRouteWarmOnClick();
    bindWidgetControls();
    cleanupQueuedFlagFromUrl();
    startQueuePolling();
    setBannerVisibility(!navigator.onLine);
    renderSyncWidget();
  });

  window.addEventListener('online', function () {
    setBannerVisibility(false);
    addSyncLog('Connection restored. Starting sync.');
    requestSyncNow();
    warmCriticalRoutes();
    setTimeout(function () {
      refreshQueueState(false);
    }, 3500);
    renderSyncWidget();
  });

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && navigator.onLine) {
      warmCriticalRoutes();
      refreshQueueState(false);
    }
  });

  window.addEventListener('offline', function () {
    setBannerVisibility(true);
    syncState.isSyncing = false;
    clearNextRetryTimer();
    addSyncLog('You are offline. Actions will queue.');
    renderSyncWidget();
  });
})();
